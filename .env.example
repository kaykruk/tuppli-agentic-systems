# =============================================================================
# Lysis Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  SECURITY WARNING: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# n8n Authentication (REQUIRED - change these immediately!)
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=         # REQUIRED: Set a strong password!

# n8n Encryption Key (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=              # REQUIRED: Generate a 64-char hex key

# -----------------------------------------------------------------------------
# n8n Configuration
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Webhook Authentication (for secure n8n <-> frontend communication)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_AUTH_HEADER=X-Lysis-Auth
N8N_WEBHOOK_AUTH_TOKEN=          # REQUIRED: Generate a secure random token

# -----------------------------------------------------------------------------
# Supabase Configuration (get from Supabase Dashboard > Settings > API)
# -----------------------------------------------------------------------------
SUPABASE_URL=                    # https://your-project.supabase.co
SUPABASE_ANON_KEY=               # Public API key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY=       # Service role key (KEEP SECRET!)
SUPABASE_DB_URL=                 # postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Redis Configuration (for n8n queue mode)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# Stripe Configuration (for payments)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ELITE=price_...

# -----------------------------------------------------------------------------
# Gemini AI Configuration (for intelligent search)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=...

# -----------------------------------------------------------------------------
# External API Keys (optional)
# -----------------------------------------------------------------------------
# WHOIS_API_KEY=                 # WhoisXML API key for domain lookups

# Google Search Console (for automated de-indexing)
# GOOGLE_CLIENT_EMAIL=           # Service account email
# GOOGLE_PRIVATE_KEY=            # Service account private key
# LEGAL_AUTOMATION_URL=http://localhost:4000
