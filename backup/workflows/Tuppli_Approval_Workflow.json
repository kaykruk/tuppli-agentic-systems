{
    "name": "Tuppli Social Approval Bridge",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "social-approval",
                "options": {}
            },
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "chatId": "={{$node[\"Webhook\"].json[\"chat_id\"] || process.env.TELEGRAM_CHAT_ID}}",
                "text": "=🚀 **New {{$node[\"Webhook\"].json[\"platform\"]}} Draft for Tuppli**\n\n{{$node[\"Webhook\"].json[\"content\"]}}\n\n---\n✅ **To Approve & Post**:\nClick the link below (this triggers the GCP script):\nhttps://n8n.tuppli.com/webhook/social-confirm?cmd={{encodeURIComponent($node[\"Webhook\"].json[\"approval_cmd\"])}}",
                "additionalFields": {
                    "parse_mode": "Markdown"
                }
            },
            "name": "Telegram",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1,
            "position": [
                350,
                300
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
                    "name": "Tuppli Bot"
                }
            }
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Telegram",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}