        "jsCode": "// Handle database fetch error\nconst error = $input.first();\n\nconsole.error('Failed to fetch recon targets:', JSON.stringify(error));\n\nreturn {\n  status: 'error',\n  message: 'Failed to fetch targets from database',\n  error: error.message || 'Unknown error',\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "handle-fetch-error",
      "name": "Handle Fetch Error",
      "type": "n8n-nodes-base.code",
