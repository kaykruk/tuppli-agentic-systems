    {
      "parameters": {
        "jsCode": "// Validate webhook authentication\nconst headers = $input.first().json.headers;\nconst expectedToken = $env.N8N_WEBHOOK_AUTH_TOKEN;\nconst authHeader = $env.N8N_WEBHOOK_AUTH_HEADER || 'X-Lysis-Auth';\n\nconst receivedToken = headers[authHeader.toLowerCase()] || headers[authHeader];\n\nif (!expectedToken) {\n  throw new Error('N8N_WEBHOOK_AUTH_TOKEN not configured');\n}\n\nif (!receivedToken || receivedToken !== expectedToken) {\n  throw new Error('Unauthorized: Invalid or missing auth token');\n}\n\nreturn $input.first().json;"
      },
      "id": "validate-test-auth",
      "name": "Validate Test Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        500
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT rt.*, t.tier, t.credits_remaining FROM recon_targets rt JOIN tenants t ON rt.tenant_id = t.id WHERE rt.status = 'pending' AND t.active = true AND t.credits_remaining > 0 AND (rt.next_scan_at IS NULL OR rt.next_scan_at <= NOW()) AND (t.tier = 'elite' OR (t.tier = 'freemium' AND rt.last_scanned_at IS NULL OR rt.last_scanned_at < NOW() - INTERVAL '24 hours')) ORDER BY rt.priority DESC LIMIT 10",
        "options": {}
      },
      "id": "fetch-targets",
      "name": "Fetch Eligible Targets",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "kR8zGvQyl8iF9qDb",
          "name": "Tuppli Supabase"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
