      "id": "dns-lookup",
      "name": "DNS Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1450,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Process scan results\nconst target = $('Process One at a Time').first().json;\nconst dnsData = $('DNS Lookup').first()?.json;\nconst tgData = $('Telegram Scraper').first()?.json;\n\n// Calculate next scan time based on tier\nlet nextScanHours = 24; // Default: freemium = daily\nif (target.tier === 'elite') {\n  nextScanHours = 1; // Elite = hourly\n}\n\nconst now = new Date();\nconst nextScan = new Date(now.getTime() + (nextScanHours * 60 * 60 * 1000));\n\n// Check if DNS lookup succeeded\nconst dnsSuccess = dnsData && !dnsData.error && dnsData.Status === 0;\nconst tgSuccess = tgData && tgData.status === 'success';\n\nreturn {\n  id: target.id,\n  tenant_id: target.tenant_id,\n  target_name: target.target_name,\n  dns_records: dnsSuccess ? dnsData : { error: 'DNS lookup failed' },\n  telegram_results: tgSuccess ? tgData : null,\n  status: 'completed',\n  last_scanned_at: now.toISOString(),\n  next_scan_at: nextScan.toISOString(),\n  scan_summary: {\n    dns_resolved: dnsSuccess,\n    answers: dnsSuccess ? (dnsData.Answer || []).length : 0,\n    telegram_targets_found: tgSuccess ? tgData.total_found : 0,\n    scanned_at: now.toISOString()\n  }\n};"
      },
      "id": "process-results",
      "name": "Process Scan Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1650,
        200
      ]
    },
