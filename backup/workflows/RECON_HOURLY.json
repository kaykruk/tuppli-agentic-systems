    {
      "parameters": {
        "jsCode": "// Check if detected account is in the creator's allowlist\nconst target = $('Process One at a Time').first().json;\nconst scanResult = $input.first().json;\n\n// Simulate detection: in production this comes from the image-hasher/dark-web-scanner\n// For now, pass through scan results for downstream allowlist check\nconst detectedAccounts = scanResult.scan_summary?.detected_accounts || [];\n\n// If no accounts detected, skip\nif (detectedAccounts.length === 0) {\n  return { ...scanResult, impersonators: [], skipped_allowlisted: 0 };\n}\n\n// Each detected account will be checked against authorized_accounts\n// via the is_authorized_account RPC function\nreturn {\n  ...scanResult,\n  detectedAccounts,\n  tenant_id: target.tenant_id,\n  check_phase: 'allowlist'\n};"
      },
      "id": "check-allowlist",
      "name": "Check Allowlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1850,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Auto-flag impersonators that are NOT in the allowlist\n// Calls the auto_flag_impersonator Supabase RPC function\nconst data = $input.first().json;\nconst detectedAccounts = data.detectedAccounts || [];\n\nconst flagged = [];\nconst skipped = [];\n\nfor (const account of detectedAccounts) {\n  // The is_authorized_account check would be done via Supabase RPC\n  // in production. Here we prepare the payload for auto_flag_impersonator.\n  flagged.push({\n    tenant_id: data.tenant_id,\n    platform: account.platform,\n    fake_username: account.username,\n    fake_profile_url: account.profile_url || null,\n    fake_profile_image_url: account.avatar_url || null,\n    similarity_score: account.similarity_score || 0.90,\n    detection_signals: {\n      username_match: account.username_match || false,\n      photo_match: account.photo_match || false,\n      bio_match: account.bio_match || false,\n      content_match: account.content_match || false\n    },\n    auto_escalated: (account.similarity_score || 0.90) >= 0.85,\n    escalation_reason: (account.similarity_score || 0.90) >= 0.85\n      ? 'Auto-confirmed: score >= 0.85'\n      : 'Flagged for review'\n  });\n}\n\nreturn {\n  ...data,\n  flagged_count: flagged.length,\n  skipped_count: skipped.length,\n  flagged,\n  needs_legal_action: flagged.filter(f => f.auto_escalated).length > 0\n};"
      },
      "id": "auto-flag-impersonator",
      "name": "Auto-Flag Impersonator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2050,
        400
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.WEBHOOK_URL }}webhook/legal-enforcer-auto",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tenant_id: $json.tenant_id, impersonators: $json.flagged.filter(f => f.auto_escalated), action: 'auto_dmca' }) }}",
        "options": {
          "timeout": 15000
        }
      },
