    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-callback-handler",
        "options": {}
      },
      "id": "8f553455-faf3-43ac-93e0-75a0d97696b7",
      "name": "Callback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        600
      ],
      "webhookId": "callback-webhook-personal"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\nif (!body) return { error: 'No body' };\n\nlet action, id, message_id, callback_query_id;\n\nif (body.callback_query) {\n  const callbackData = body.callback_query.data.replace(/^=/, '');\n  [action, id] = callbackData.split(':');\n  message_id = body.callback_query.message.message_id;\n  callback_query_id = body.callback_query.id;\n} else if (body.message && body.message.text) {\n  const text = body.message.text;\n  const match = text.match(/\\/(approve|edit)\\s*(\\d+)?/);\n  if (match) {\n    action = match[1];\n    id = match[2];\n    message_id = body.message.message_id;\n  }\n}\n\nreturn { \n  action, \n  id, \n  message_id, \n  callback_query_id,\n  is_command: !!body.message\n};"
      },
      "name": "Parse Incoming",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        600
      ],
      "id": "c62f8a12-6b94-4d1a-9f5b-123456789abc"
    },
    {
      "parameters": {
        "conditions": {
